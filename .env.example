# PEFT_* environment variables — every hyperparameter of the experiment
# pipeline is overridable here. Resolution order: CLI flag > PEFT_* env > default.
#
# Usage:
#   export $(grep -vE '^\s*#|^\s*$' .env.example | xargs)   # or: source .env.example
#   ../../.venv/bin/python methods/qlora.py
#   ../../.venv/bin/python tune.py --n_trials 150 --timeout 12h

# --- model & data -----------------------------------------------------------
PEFT_MODEL=Qwen/Qwen2.5-0.5B-Instruct
PEFT_DATASET_NAME=tatsu-lab/alpaca
#PEFT_DATASET_SUBSET=default
PEFT_NUM_TRAIN=2000
PEFT_NUM_EVAL=128

# --- training ---------------------------------------------------------------
PEFT_EPOCHS=3
PEFT_BATCH_SIZE=4
PEFT_GRAD_ACCUM=2
PEFT_LEARNING_RATE=2e-4
PEFT_MAX_LENGTH=512
PEFT_SEED=42
PEFT_LOGGING_STEPS=5
PEFT_EVAL_STEPS=50
PEFT_SAVE_STEPS=250

# --- QLoRA / LoRA -----------------------------------------------------------
PEFT_R=16
PEFT_LORA_ALPHA=32
PEFT_LORA_DROPOUT=0.05
PEFT_TARGET_MODULES=q_proj,k_proj,v_proj,o_proj,gate_proj,up_proj,down_proj
PEFT_QUANT_TYPE=nf4
PEFT_DOUBLE_QUANT=true
PEFT_GRADIENT_CHECKPOINTING=true

# --- observability / output -------------------------------------------------
PEFT_MLFLOW_TRACKING_URI=http://127.0.0.1:5000
PEFT_MLFLOW_EXPERIMENT=peft-experiments
PEFT_OUTPUT_DIR=output

# --- tuner search-space overrides (tune.py only) ----------------------------
# Comma-separated candidate values the sampler may pick:
#PEFT_TUNE_NUM_TRAIN=500,1000,2000
#PEFT_TUNE_MAX_LENGTH=256,512
#PEFT_TUNE_EPOCHS=2,3

# --- Clef Flash latency probe (scripts/probe_clef.py; put real values in .env) -
#OPENAI_BASE_URL=http://<omlx-host>:8000/v1
#OPENAI_API_KEY=<your-oMLX-key>
